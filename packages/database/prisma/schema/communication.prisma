enum CommunicationTargetStatus {
    PENDING
    PROCESSING
    SENT
    FAILED
    CANCELLED

    @@schema("public")
}

model Communication {
    id   Int    @id @default(autoincrement())
    uuid String @unique @default(uuid())

    xrefId String?

    title   String
    message String?
    subject String?

    audioURL Json? @db.JsonB()

    // Shared across all group deliveries
    transportId String?

    isDeleted Boolean @default(false)
    createdBy String?

    createdAt DateTime  @default(now())
    updatedAt DateTime? @updatedAt()

    targets CommunicationGroupTarget[]

    @@index([xrefId])
    @@index([transportId])
    @@map("tbl_communications")
    @@schema("public")
}

model CommunicationGroupTarget {
    id   Int    @id @default(autoincrement())
    uuid String @unique @default(uuid())

    communicationId Int

    groupId   String
    groupType String

    // Different for each group delivery
    sessionId String?

    status CommunicationTargetStatus @default(PENDING)
    error  String?

    createdAt DateTime  @default(now())
    updatedAt DateTime? @updatedAt()

    communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

    @@unique([communicationId, groupType, groupId])
    @@index([groupType, groupId])
    @@map("tbl_communication_group_targets")
    @@schema("public")
}
